# Application Settings
PROJECT_NAME="LiveChat Workspace Backend"
API_V1_STR="/api/v1"
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/livechat_db

# Cache / Realtime (Redis)
REDIS_URL=redis://localhost:6379/0
